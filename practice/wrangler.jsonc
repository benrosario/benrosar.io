{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Static CS 61A exam practice site, served at practice.benrosar.io.
  "name": "benrosar-io-practice",
  "compatibility_date": "2026-09-16",
  "account_id": "abfb73a975a267f55e5755d5cfc9be70",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "practice.benrosar.io",
      "custom_domain": true
    }
  ],
  // Only POST /e (usage events) runs the Worker; everything else is served as static files.
  "main": "./worker.js",
  "assets": {
    "directory": "./public",
    "not_found_handling": "none",
    "run_worker_first": ["/e"]
  },
  "analytics_engine_datasets": [
    {
      "binding": "EVENTS",
      "dataset": "practice_events"
    }
  ]
}
